{
  "name": "dily",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "pnpm --filter @dily/mobile start",
    "ios": "pnpm --filter @dily/mobile ios",
    "android": "pnpm --filter @dily/mobile android",
    "dev:api": "pnpm --filter @dily/api dev",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @dily/api db:migrate",
    "db:seed": "pnpm --filter @dily/api db:seed",
    "db:reset": "pnpm --filter @dily/api db:reset",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  }
}
