{
  "expo": {
    "name": "dily",
    "slug": "dily",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ios-light.png",
    "userInterfaceStyle": "light",
    "scheme": "dily",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dily"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F5ED"
      },
      "package": "com.dily"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "react-native-bootsplash",
        {
          "logo": "./assets/splash-icon-light.png",
          "logoWidth": 210,
          "background": "#f7f5ed",
          "assetsOutput": "assets/bootsplash"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dily needs access to your photos to let you upload profile pictures and attach images to your products."
        }
      ],
      "expo-secure-store",
      "expo-image",
      "./plugins/with-min-pod-deployment-target",
      "./plugins/with-scene-lifecycle"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
