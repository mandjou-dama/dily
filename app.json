{
  "expo": {
    "name": "dily",
    "slug": "dily",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ios-light.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "dily",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dily"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F5ED"
      },
      "package": "com.dily"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "react-native-bootsplash",
        {
          "assetsDir": "assets/bootsplash"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dily needs access to your photos to let you upload profile pictures and attach images to your products."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
