# Copy to supabase/functions/.env for local dev; on the hosted project set
# them with `supabase secrets set --env-file ...`.

# From Auth > Hooks > Send SMS (format v1,whsec_<base64>). Locally, the same
# value must be in supabase/.env so config.toml can read it.
SEND_SMS_HOOK_SECRET=

# Meta > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
# Permanent token of a Meta "system user" with whatsapp_business_messaging
WHATSAPP_ACCESS_TOKEN=
# Approved AUTHENTICATION template with a copy-code button
WHATSAPP_TEMPLATE_NAME=dily_login_code
WHATSAPP_TEMPLATE_LANGUAGE=fr
# Optional, defaults to https://graph.facebook.com/v23.0
# WHATSAPP_API_BASE=
