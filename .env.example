# Copy to `.env` (git-ignored) for local development. Read by docker compose,
# the API (`pnpm dev:api`), Prisma and the API tests.

# --- Docker (local Postgres and Redis) ---
POSTGRES_USER=dily
POSTGRES_PASSWORD=dily
POSTGRES_DB=dily
POSTGRES_PORT=5434
REDIS_PORT=6380

# --- API ---
NODE_ENV=development
API_PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgresql://dily:dily@localhost:5434/dily
REDIS_URL=redis://localhost:6380/0

# Secrets: at least 32 characters each, e.g. `openssl rand -base64 48`
PHONE_HASH_PEPPER=change-me-local-pepper-0000000000000000
JWT_ACCESS_SECRET=change-me-local-jwt-secret-000000000000

# Where sign-in codes go: `console` writes them to the API logs (dev only),
# `whatsapp` sends them through Meta's Cloud API (WHATSAPP_* below), `none`
# lets only TEST_PHONES sign in.
OTP_SENDER=console
# Test numbers (E.164, comma-separated): never messaged, the code is always
# TEST_PHONE_CODE. Same lifetime, attempts and rate limits as real codes.
TEST_PHONES=+22370000000
TEST_PHONE_CODE=123456

# Uploaded images, stored on disk and served under /media (relative to apps/api)
MEDIA_DIR=./uploads

# Meta > WhatsApp > API Setup (only with OTP_SENDER=whatsapp)
WHATSAPP_PHONE_NUMBER_ID=
# Permanent token of a Meta "system user" with whatsapp_business_messaging
WHATSAPP_ACCESS_TOKEN=
# Approved AUTHENTICATION template with a copy-code button
WHATSAPP_TEMPLATE_NAME=dily_login_code
WHATSAPP_TEMPLATE_LANGUAGE=fr
WHATSAPP_API_BASE=https://graph.facebook.com/v23.0

# --- API tests (`pnpm test`): separate database and Redis db ---
TEST_DATABASE_URL=postgresql://dily:dily@localhost:5434/dily_test
TEST_REDIS_URL=redis://localhost:6380/1
