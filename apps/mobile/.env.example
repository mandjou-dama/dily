# Copy to .env.development.local (git-ignored) for dev builds.
# The iOS simulator reaches the Mac's localhost; a real phone needs the Mac's
# LAN address, e.g. http://192.168.1.20:3001.
EXPO_PUBLIC_API_URL=http://localhost:3001
# Optional: where uploaded images are served (defaults to <API URL>/media)
# EXPO_PUBLIC_MEDIA_URL=
