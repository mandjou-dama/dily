{
  "expo": {
    "name": "dily",
    "slug": "dily",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ios-light.png",
    "userInterfaceStyle": "light",
    "scheme": "dily",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dily"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F5ED"
      },
      "package": "com.dily"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-light.png",
          "imageWidth": 210,
          "resizeMode": "contain",
          "backgroundColor": "#f7f5ed"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dily needs access to your photos to let you upload profile pictures and attach images to your products.",
          "cameraPermission": "Dily uses the camera so you can photograph the items you sell."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#3C5627"
        }
      ],
      "expo-image",
      "./plugins/with-min-pod-deployment-target",
      "./plugins/with-scene-lifecycle",
      "expo-font"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
