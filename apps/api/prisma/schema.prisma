// Dily data model. Models and fields are camelCase in TypeScript, tables and
// columns snake_case in the database. Prices are whole F CFA (XOF has no
// minor unit). Image columns hold a media path; a value starting with "http"
// is an external URL (seed data only).
//
// Not expressed here, so only in migrations: the pg_trgm extension, CHECK
// constraints, the partial unique indexes on offers, orders, payments and
// reports, and the triggers that keep `likes_count` and `last_message_at` up
// to date.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  /// E.164, e.g. "+22370000000"
  phoneE164       String           @unique @map("phone_e164")
  /// HMAC-SHA256 of the number (src/lib/phone-hash.ts): finds the account
  /// without looking the number up in clear
  phoneHash       String           @unique @map("phone_hash")
  fullName        String?          @map("full_name")
  avatarPath      String?          @map("avatar_path")
  /// Where the seller meets buyers: "Hamdallaye ACI"
  neighbourhood   String?
  city            String           @default("Bamako")
  /// Test number (TEST_PHONES): set at sign-in, never by the app
  isTester        Boolean          @default(false) @map("is_tester")
  /// Where the seller receives what buyers paid: both set or both null (CHECK)
  payoutProvider  PaymentProvider? @map("payout_provider")
  /// E.164: the mobile money account money is sent to
  payoutPhone     String?          @map("payout_phone")
  /// Set by Dily's moderation: the account can't sign in, and its listings
  /// are hidden from everyone
  suspendedAt     DateTime?        @map("suspended_at") @db.Timestamptz(3)
  /// The terms of use accepted (TERMS_VERSION, a date), and when
  termsVersion    String?          @map("terms_version")
  termsAcceptedAt DateTime?        @map("terms_accepted_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens         RefreshToken[]
  products              Product[]
  likes                 Like[]
  conversationsAsBuyer  Conversation[] @relation("ConversationBuyer")
  conversationsAsSeller Conversation[] @relation("ConversationSeller")
  messages              Message[]
  pushTokens            PushToken[]
  offers                Offer[]
  ordersAsBuyer         Order[]        @relation("OrderBuyer")
  ordersAsSeller        Order[]        @relation("OrderSeller")
  transfers             Transfer[]
  blocksMade            Block[]        @relation("Blocker")
  blocksReceived        Block[]        @relation("Blocked")
  reportsMade           Report[]       @relation("Reporter")
  reportsReceived       Report[]       @relation("ReportedUser")

  @@map("users")
}

enum PushPlatform {
  ios
  android

  @@map("push_platform")
}

/// Expo Push token of a signed-in device; a token belongs to one account at a time
model PushToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  token     String       @unique
  platform  PushPlatform
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// SHA-256 of the token; the token itself is never stored
  tokenHash    String    @unique @map("token_hash")
  deviceId     String    @map("device_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Set when the token was rotated: id of its successor
  replacedById String?   @map("replaced_by_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deviceId])
  @@map("refresh_tokens")
}

model Category {
  id       Int    @id @default(autoincrement()) @db.SmallInt
  slug     String @unique
  name     String
  position Int    @default(0) @db.SmallInt

  products Product[]

  @@map("categories")
}

enum ProductStatus {
  active
  sold
  /// Removed by Dily (moderation): only its seller still sees it, and can't
  /// put it back on sale
  archived

  @@map("product_status")
}

enum ProductCondition {
  new
  like_new
  good
  used

  @@map("product_condition")
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  sellerId    String           @map("seller_id") @db.Uuid
  categoryId  Int?             @map("category_id") @db.SmallInt
  title       String
  description String?
  price       Int
  currency    String           @default("XOF") @db.Char(3)
  size        String?
  condition   ProductCondition @default(good)
  status      ProductStatus    @default(active)
  /// The buyer can come and get it, in the seller's neighbourhood
  pickup      Boolean          @default(true)
  /// What delivery adds to the price, the seller's to arrange; null: no
  /// delivery. At least one of pickup and delivery (CHECK)
  deliveryFee Int?             @map("delivery_fee")
  /// Kept by the likes trigger, never written by the API
  likesCount  Int              @default(0) @map("likes_count")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller        User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images        ProductImage[]
  likes         Like[]
  conversations Conversation[]
  orders        Order[]
  reports       Report[]

  @@index([status, createdAt(sort: Desc)], map: "products_feed_idx")
  @@index([categoryId, status, createdAt(sort: Desc)], map: "products_category_feed_idx")
  @@index([sellerId, createdAt(sort: Desc)], map: "products_seller_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_title_trgm_idx")
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  path      String
  position  Int      @default(0) @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@index([path])
  @@map("product_images")
}

model Like {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
  @@map("likes")
}

model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  buyerId       String    @map("buyer_id") @db.Uuid
  sellerId      String    @map("seller_id") @db.Uuid
  /// Kept by the messages trigger
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer    User      @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User      @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages Message[]
  offers   Offer[]
  orders   Order[]
  reports  Report[]

  @@unique([productId, buyerId])
  @@index([buyerId, lastMessageAt(sort: Desc)])
  @@index([sellerId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

enum MessageKind {
  text
  /// A price offer: the card shows the offer's current state
  offer
  /// "Deal": an offer was accepted, or a direct buy was paid
  deal
  /// The item changed hands (handover code, or the buyer confirmed): the
  /// money goes to the seller
  handover
  /// The buyer reported a problem: Dily keeps the money
  dispute
  /// The buyer got their money back
  refund

  @@map("message_kind")
}

model Message {
  /// Client-generated ids allow optimistic sends without duplicates
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderId       String      @map("sender_id") @db.Uuid
  kind           MessageKind @default(text)
  /// What the person wrote; for an offer or a deal, a French summary
  /// ("Offre : 17 200 F, livraison comprise") for previews and push
  body           String
  /// Set on offer messages only (CHECK)
  offerId        String?     @unique @map("offer_id") @db.Uuid
  /// Set on deal, handover, dispute and refund messages only (CHECK)
  orderId        String?     @map("order_id") @db.Uuid
  readAt         DateTime?   @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  offer        Offer?       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([orderId])
  @@map("messages")
}

enum Fulfilment {
  /// The buyer comes to the seller's neighbourhood
  pickup
  /// The seller sends a courier to the buyer
  delivery

  @@map("fulfilment")
}

/// `pending` past `expires_at` reads as expired; it's only written as
/// `expired` when something else touches the conversation
enum OfferStatus {
  pending
  accepted
  declined
  /// A newer offer in the same conversation took its place
  superseded
  expired

  @@map("offer_status")
}

/// A price proposed in a conversation, by the buyer or, in reply, the
/// seller. One amount: the total the buyer pays, delivery included. At most
/// one pending offer per conversation (partial unique index).
model Offer {
  /// Generated by the app: sending again after a network error never duplicates
  id             String      @id @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  authorId       String      @map("author_id") @db.Uuid
  /// Total the buyer pays, delivery included
  amount         Int
  /// Chosen by the buyer; a seller's counter-offer keeps it
  fulfilment     Fulfilment
  /// The listing's delivery fee when the offer was made; null for pickup
  deliveryFee    Int?        @map("delivery_fee")
  /// Where to deliver: "Hamdallaye ACI"; null for pickup
  deliveryArea   String?     @map("delivery_area")
  /// The listing's price when the offer was made: what "1 500 F de moins"
  /// compares to (plus the delivery fee)
  listPrice      Int         @map("list_price")
  status         OfferStatus @default(pending)
  expiresAt      DateTime    @map("expires_at") @db.Timestamptz(3)
  respondedAt    DateTime?   @map("responded_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  message      Message?
  order        Order?

  @@index([conversationId, createdAt(sort: Desc)])
  @@map("offers")
}

/// `awaiting_payment` past `reserved_until` reads as expired; it's only
/// written as `expired` when the listing is ordered again
enum OrderStatus {
  awaiting_payment
  paid
  /// The buyer made a new offer instead of paying, or one of the two
  /// blocked the other
  cancelled
  expired
  /// The item changed hands: the money goes to the seller
  completed
  /// The buyer reported a problem: Dily keeps the money until it decides
  disputed
  /// The buyer got their money back: not handed over in time, refunded by
  /// the seller, or Dily's decision
  refunded

  @@map("order_status")
}

/// A purchase: an accepted offer, or a direct buy. While it waits for
/// payment the listing is held for the buyer. At most one order awaiting
/// payment or paid per listing (partial unique index).
model Order {
  id                String      @id @default(uuid()) @db.Uuid
  conversationId    String      @map("conversation_id") @db.Uuid
  productId         String      @map("product_id") @db.Uuid
  buyerId           String      @map("buyer_id") @db.Uuid
  sellerId          String      @map("seller_id") @db.Uuid
  /// Null for a direct buy
  offerId           String?     @unique @map("offer_id") @db.Uuid
  /// Total the buyer pays, delivery included
  amount            Int
  /// The listing's price at the time: shown struck through next to `amount`
  listPrice         Int         @map("list_price")
  fulfilment        Fulfilment
  deliveryFee       Int?        @map("delivery_fee")
  deliveryArea      String?     @map("delivery_area")
  /// For the courier, delivery only: "derrière la pharmacie, portail vert"
  landmark          String?
  /// The number the courier calls, delivery only: E.164
  contactPhone      String?     @map("contact_phone")
  status            OrderStatus @default(awaiting_payment)
  /// The listing is held for the buyer until then
  reservedUntil     DateTime    @map("reserved_until") @db.Timestamptz(3)
  paidAt            DateTime?   @map("paid_at") @db.Timestamptz(3)
  /// 4 digits, set once paid: the buyer gives it to the seller (or the
  /// courier) once they have the item. Never shown to the seller
  handoverCode      String?     @map("handover_code")
  /// Reminders sent to the seller to hand the item over (2 days, 5 days)
  handoverReminders Int         @default(0) @map("handover_reminders")
  /// Handed over: the money goes to the seller
  completedAt       DateTime?   @map("completed_at") @db.Timestamptz(3)
  refundedAt        DateTime?   @map("refunded_at") @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer        User         @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller       User         @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  offer        Offer?       @relation(fields: [offerId], references: [id], onDelete: SetNull)
  messages     Message[]
  payments     Payment[]
  dispute      Dispute?
  transfer     Transfer?

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([productId])
  /// Paid orders waiting for the handover: reminders and refunds (job)
  @@index([status, paidAt])
  @@map("orders")
}

enum PaymentProvider {
  orange_money
  moov_money

  @@map("payment_provider")
}

/// `pending` past `expires_at` reads as expired; it's only written as
/// `expired` when the buyer tries again
enum PaymentStatus {
  pending
  succeeded
  failed
  /// The buyer gave up waiting ("Je n'ai rien reçu")
  cancelled
  expired

  @@map("payment_status")
}

/// One attempt to pay an order with mobile money: the operator asks the
/// payer to confirm on their phone, then answers. At most one pending and
/// one succeeded payment per order (partial unique indexes).
model Payment {
  /// Generated by the app: sending again after a network error never duplicates
  id            String          @id @db.Uuid
  orderId       String          @map("order_id") @db.Uuid
  provider      PaymentProvider
  /// E.164: the mobile money account that pays
  payerPhone    String          @map("payer_phone")
  amount        Int
  status        PaymentStatus   @default(pending)
  /// Why the operator said no: "refused", "insufficient_funds", "unavailable"
  failureReason String?         @map("failure_reason")
  /// The operator's id for the transaction, once it answered
  reference     String?
  expiresAt     DateTime        @map("expires_at") @db.Timestamptz(3)
  settledAt     DateTime?       @map("settled_at") @db.Timestamptz(3)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt(sort: Desc)])
  @@map("payments")
}

enum DisputeReason {
  not_received
  /// Not what the listing showed: a photo is required
  not_as_described
  other

  @@map("dispute_reason")
}

enum DisputeStatus {
  open
  /// The buyer got their money back (the seller refunded, or Dily decided)
  refunded
  /// The money went to the seller (handover code, or Dily decided)
  released

  @@map("dispute_status")
}

/// A problem the buyer reported on a paid order: the money stays with Dily
/// until the seller refunds, the item changes hands, or Dily decides.
model Dispute {
  id         String        @id @default(uuid()) @db.Uuid
  orderId    String        @unique @map("order_id") @db.Uuid
  reason     DisputeReason
  /// What the buyer wrote, up to 500 characters
  note       String?
  /// Uploaded photos (`reports/<buyer id>/<id>`), at least one for
  /// not_as_described (CHECK)
  photoPaths String[]      @map("photo_paths")
  status     DisputeStatus @default(open)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt DateTime?     @map("resolved_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("disputes")
}

enum TransferKind {
  /// What the buyer paid, to the seller
  payout
  /// Back to the number that paid
  refund

  @@map("transfer_kind")
}

enum TransferStatus {
  /// A payout for a seller who hasn't said where to receive money yet
  awaiting_account
  /// Sent to the operator, waiting for its answer
  pending
  succeeded
  /// Tried again later (`next_attempt_at`), or when the seller changes
  /// their payout account
  failed

  @@map("transfer_status")
}

/// Money Dily sends once an order is settled: to the seller once the item
/// changed hands, or back to the buyer. One per order.
model Transfer {
  id            String           @id @default(uuid()) @db.Uuid
  orderId       String           @unique @map("order_id") @db.Uuid
  kind          TransferKind
  /// Who receives it: the seller for a payout, the buyer for a refund
  recipientId   String           @map("recipient_id") @db.Uuid
  amount        Int
  /// Where it goes; null while awaiting the seller's account
  provider      PaymentProvider?
  phone         String?
  status        TransferStatus
  failureReason String?          @map("failure_reason")
  /// The operator's id for the transaction
  reference     String?
  attempts      Int              @default(0)
  nextAttemptAt DateTime?        @map("next_attempt_at") @db.Timestamptz(3)
  settledAt     DateTime?        @map("settled_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recipient User  @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([recipientId, status])
  @@map("transfers")
}

/// One person blocking another: neither sees the other's listings, nor can
/// write to, make an offer to or buy from the other. A paid order between
/// them still goes to its end (handover code, report, refund).
model Block {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

enum ReportKind {
  listing
  /// The other person of a conversation
  user

  @@map("report_kind")
}

enum ReportReason {
  prohibited
  counterfeit
  scam
  harassment
  offensive
  spam
  other

  @@map("report_reason")
}

enum ReportStatus {
  open
  /// Nothing against the rules
  dismissed
  /// Dily acted: the listing removed, or the account suspended
  actioned

  @@map("report_status")
}

/// A listing or a person reported to Dily, which answers within 24 hours
/// (App Store guideline 1.2), through a script until an admin screen
/// exists. One open report per reporter and listing or person (partial
/// unique indexes).
model Report {
  id             String       @id @default(uuid()) @db.Uuid
  kind           ReportKind
  /// Null once the reporter deleted their account: the report stays
  reporterId     String?      @map("reporter_id") @db.Uuid
  /// The person reported: the listing's seller for a listing
  reportedUserId String       @map("reported_user_id") @db.Uuid
  /// The listing reported; null for a person, or once the seller deleted it
  productId      String?      @map("product_id") @db.Uuid
  /// Where the person was reported from: Dily reads it to check
  conversationId String?      @map("conversation_id") @db.Uuid
  reason         ReportReason
  /// What the reporter wrote, up to 500 characters
  note           String?
  status         ReportStatus @default(open)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt     DateTime?    @map("resolved_at") @db.Timestamptz(3)

  reporter     User?         @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reportedUser User          @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reportedUserId])
  @@index([productId])
  @@map("reports")
}
